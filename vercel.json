{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "skinbid.me" }],
      "destination": "https://www.skinbid.me/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "skinbid.me" }],
      "destination": "https://www.skinbid.me/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/official-og",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/close-auctions",
      "schedule": "0 5 * * *"
    }
  ]
}
