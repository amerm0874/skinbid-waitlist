NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SECRET_KEY=

# Email/password login. Google is enabled in Supabase → Authentication → Providers.
# No GOOGLE_* keys in this app. In Authentication → URL Configuration, add:
# http://localhost:3000/auth/callback
# https://www.skinbid.me/auth/callback

# false unlocks /events, /login, /e/[slug], and bidding. Landing and waitlist stay as they are.
WAITLIST_ONLY=false

# Polar sandbox. If POLAR_ACCESS_TOKEN is set, Bid opens Polar checkout.
# Webhook: POST /api/webhooks/polar → bid held. Create the endpoint in sandbox.polar.sh.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# Optional. Empty = reuse or create a one-time "SkinBid zone bid" product.
POLAR_PRODUCT_ID=

DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_BID_PRODUCT_ID=
# test_mode or live_mode
DODO_PAYMENTS_ENV=test_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Emails people who join the waitlist. Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# Must be a domain verified in Resend. For tests use: SkinBid <beth.t@example.com>
RESEND_FROM=SkinBid <hey@skinbid.com>

# Comma-separated. These emails can open /admin and /inbox.

ADMIN_EMAILS=

# Required. Vercel Cron sends this as Authorization: Bearer <secret>
CRON_SECRET=change-me

# Page views + Waitlist Submit event. Example: skinbid.com
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
