NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SECRET_KEY=

# Email/password login. Google is enabled in Supabase → Authentication → Providers.
# No GOOGLE_* keys in this app. No Apple. In Authentication → URL Configuration:
# Site URL must be https://www.skinbid.me (not localhost).
# Redirect URLs must include both:
# http://localhost:3000/auth/callback
# https://www.skinbid.me/auth/callback
# Turn on Automatic linking so Google and a magic link on the same email
# reuse one profile.

# false unlocks /events, /login, /e/[slug], and bidding. Landing stays as it is.
WAITLIST_ONLY=false

# Whop Payments. Bid stays pending until webhook payment.succeeded.
# USD, card/Apple Pay/Google Pay buttons only. No unpaid held bids.
# Webhook: POST /api/webhooks/whop — payment.succeeded and payment.failed.
# Vercel: live keys only. Do not set WHOP_SANDBOX there.
# Do not copy live Vercel apik_ / biz_ / ws_ into .env.local.
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_COMPANY_ID=
# SANDBOX_ONLY — local .env.local only. WHOP_SANDBOX=1 → sandbox API + sandbox.whop.com.
# Off or missing → live Whop, same as production. Never set this on Vercel.
# To remove sandbox: delete this flag, the host rewrite, and every SANDBOX_ONLY block.
# WHOP_SANDBOX=1

# Transactional mail (held, outbid, won, proof, refund). Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# Production From is SkinBid <notify@skinbid.me>. Reply-To is skinbidme@gmail.com.
# If skinbid.me is not verified in Resend, set a verified sender, e.g. SkinBid <beth.t@example.com>
RESEND_FROM=

# Comma-separated. These emails can open /admin and /inbox.

ADMIN_EMAILS=

# Required. Vercel Cron sends this as Authorization: Bearer <secret>
CRON_SECRET=change-me

# Page views + Waitlist Submit event. Example: skinbid.com
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# PostHog product analytics. Empty key = no-op. Browser traffic
# goes through /ingest (see next.config.ts). Server events use the same key.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
