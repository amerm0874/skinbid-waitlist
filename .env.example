NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SECRET_KEY=

# Keep true until auctions go live. false unlocks /events and the rest.
WAITLIST_ONLY=true

DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_BID_PRODUCT_ID=
# test_mode or live_mode
DODO_PAYMENTS_ENV=test_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode

RESEND_API_KEY=
RESEND_FROM=SkinBid <hey@skinbid.com>

# Comma-separated. These emails can open /admin.
ADMIN_EMAILS=

# Required. Vercel Cron sends this as Authorization: Bearer <secret>
CRON_SECRET=change-me

# Optional. Unlocks /inbox on the live site. Falls back to CRON_SECRET.
WAITLIST_INBOX_KEY=

# Page views + Waitlist Submit event. Example: skinbid.com
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
