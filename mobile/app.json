{
  "expo": {
    "name": "SkinBid",
    "slug": "skinbid-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "skinbid",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0b0c",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "SkinBid needs photo library access so you can upload your profile photo, brand logo, and event proof photos.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "me.skinbid.app"
    },
    "android": {
      "package": "me.skinbid.app",
      "adaptiveIcon": {
        "backgroundColor": "#0b0b0c",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0b0c",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "SkinBid needs photo library access so you can upload your profile photo, brand logo, and event proof photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8099003b-572a-431c-aafd-dcc4fd2d3418"
      }
    },
    "owner": "coveivf"
  }
}
