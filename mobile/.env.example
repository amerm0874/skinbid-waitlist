EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Same values as the web app's NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY
# (see ../.env.example) — this app talks to the same Supabase project.
# The EXPO_PUBLIC_ prefix means these are inlined into the client bundle, same
# as NEXT_PUBLIC_ on the web app. Never put the service-role key here.
